# AWS Bedrock Configuration (Optional - Airlock runs offline with built-in fallbacks)
# Set these if you want to run live Amazon Bedrock generative calls:

AWS_REGION=us-east-1
AIRLOCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: set to 'bedrock' to use live Bedrock fact extraction instead of local regex extractor
AIRLOCK_SANITIZER=bedrock
