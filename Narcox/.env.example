# --- Existing config ---

# Mongo connection string. If unset, the app falls back to an in-memory
# store (fine for local dev / demo / tests, not persisted across restarts).
MONGODB_URI=
MONGODB_DB=narcox

# --- Telegram webhook (api/telegram/webhook.js) ---

# Bot token from @BotFather. Used to register this endpoint with Telegram
# via setWebhook and for any outbound calls to the Telegram Bot API (e.g.
# replies); the webhook handler itself does not read this variable.
TELEGRAM_BOT_TOKEN=

# --- Instagram webhook (api/instagram/webhook.js) ---

# Arbitrary string you choose and enter in the Meta App Dashboard when
# subscribing this URL. Meta echoes it back on the GET verification
# handshake; the handler only accepts the handshake if it matches exactly.
INSTAGRAM_VERIFY_TOKEN=

# Instagram Graph API access token for outbound calls (e.g. sending
# replies). Not required to receive or verify webhook events.
INSTAGRAM_ACCESS_TOKEN=
